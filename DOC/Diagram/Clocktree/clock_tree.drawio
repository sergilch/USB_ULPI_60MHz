<mxfile host="drawio" version="24.7.17"><diagram id="clocktree" name="Clock tree"><mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c11" value="&lt;b style='font-size:20px'&gt;USB 2.0 ULPI PHY – clock tree (digital half)&lt;/b&gt;&lt;br&gt;Status Plan_60MHz.md P9 (2026-11-15). FF = registers per clock from the sized STA (Plan_60MHz.md 8.11). Blocks below are designed / constrained for this structure; top-level wiring is WORK_PLAN 8.1." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1500" height="50" as="geometry"/></mxCell><mxCell id="c12" value="AFE (analog, separate design)" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;strokeColor=#9E9E9E;fillColor=#F5F5F5;verticalAlign=top;align=left;spacingLeft=8;fontSize=14;fontStyle=1;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="370" height="920" as="geometry"/></mxCell><mxCell id="c13" value="Digital (this repo, X-FAB xh018 D_CELLS_JIHD)" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;strokeColor=#424242;fillColor=#FFFFFF;verticalAlign=top;align=left;spacingLeft=8;fontSize=14;fontStyle=1;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="420" y="70" width="1090" height="1000" as="geometry"/></mxCell><mxCell id="c14" value="Off-chip / pads" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;strokeColor=#9E9E9E;fillColor=#F5F5F5;verticalAlign=top;align=left;spacingLeft=8;fontSize=14;fontStyle=1;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1540" y="70" width="240" height="440" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Crystal oscillator / REFCLK buffer&lt;/b&gt;&lt;br&gt;CDR_FREF = &lt;b&gt;24 MHz&lt;/b&gt; ±500 ppm" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;strokeColor=#EF6C00;fillColor=#FAFAFA;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="330" height="70" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;REF_DIG buffer&lt;/b&gt;&lt;br&gt;→ &lt;b&gt;ref_clk 24 MHz&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;strokeColor=#EF6C00;fillColor=#FFF3E0;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="200" height="60" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;PLL (lower loop)&lt;/b&gt;&lt;br&gt;fixed ×20 (÷20 feedback)&lt;br&gt;VCO 400–500 MHz&lt;br&gt;CLK_BIT_A → &lt;b&gt;clk_bit 480 MHz&lt;/b&gt;&lt;br&gt;&lt;i&gt;CLK60_A ÷8 output: proposed, not wired&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;strokeColor=#C62828;fillColor=#FFEBEE;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="350" width="330" height="110" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;CDR (upper loop, bang-bang)&lt;/b&gt;&lt;br&gt;VCO free-runs ≈ 480 MHz without data&lt;br&gt;→ &lt;b&gt;clk_rx 480 MHz ±1000 ppm&lt;/b&gt;, hs_rxd&lt;br&gt;CDR_EN = 0: clk_rx stops low" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;strokeColor=#2E7D32;fillColor=#E8F5E9;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="330" height="110" as="geometry"/></mxCell><mxCell id="c19" value="&lt;i&gt;CLK60_A 60 MHz&lt;br&gt;(proposed)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;strokeColor=#9E9E9E;fillColor=#FFFFFF;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;dashed=1;fontColor=#757575;" vertex="1" parent="1"><mxGeometry x="250" y="520" width="120" height="50" as="geometry"/></mxCell><mxCell id="c20" value="CDR_FREF" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#EF6C00;strokeWidth=2;endArrow=block;endFill=1;fontColor=#EF6C00;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c15" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="CDR_FREF 24 MHz" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#EF6C00;strokeWidth=2;endArrow=block;endFill=1;fontColor=#EF6C00;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0.85;exitY=1;exitDx=0;exitDy=0;entryX=0.85;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c15" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="coarse loop" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#757575;strokeWidth=1;endArrow=block;endFill=1;fontColor=#757575;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c17" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#757575;strokeWidth=1;endArrow=block;endFill=1;fontColor=#757575;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.85;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c17" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="&lt;b&gt;usb_pwr_seq&lt;/b&gt; – sequencer &lt;b&gt;40 FF&lt;/b&gt;&lt;br&gt;runs while PLL is off; bias_en / pll_en / iso_en&lt;br&gt;&lt;span style='color:#1565C0'&gt;+ clk60: 8 FF&lt;/span&gt;, &lt;span style='color:#C62828'&gt;clk_bit: clk_en_b 2 FF&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;strokeColor=#EF6C00;fillColor=#FFF3E0;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="480" y="110" width="300" height="95" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;usb_pll_lock_det&lt;/b&gt; – reference window &lt;b&gt;21 FF&lt;/b&gt;&lt;br&gt;2^NW ref_clk cycles; dead-clock check of the clk60/16 heartbeat&lt;br&gt;&lt;span style='color:#1565C0'&gt;+ clk60: 37 FF&lt;/span&gt;, &lt;span style='color:#C62828'&gt;clk_bit: 17 FF&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;strokeColor=#EF6C00;fillColor=#FFF3E0;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="820" y="110" width="330" height="95" as="geometry"/></mxCell><mxCell id="c26" value="ref_clk 24 MHz" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#EF6C00;strokeWidth=3;endArrow=block;endFill=1;fontColor=#EF6C00;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c16" target="c24"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="400" y="260"/><mxPoint x="400" y="157"/></Array></mxGeometry></mxCell><mxCell id="c27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#EF6C00;strokeWidth=3;endArrow=block;endFill=1;fontColor=#EF6C00;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c16" target="c25"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="410" y="248"/><mxPoint x="410" y="92"/><mxPoint x="985" y="92"/></Array></mxGeometry></mxCell><mxCell id="c28" value="&lt;b&gt;usb_clk_gen&lt;/b&gt; – &lt;b&gt;11 FF&lt;/b&gt; on clk_bit&lt;br&gt;4-bit Johnson ÷8 counter (phase 0–7, E0 = tick edge)&lt;br&gt;• clk60 flop: rises E0, falls E4 (50 %, free-running)&lt;br&gt;• ld = phase 3 (island update on E4), phase_j[3:0]&lt;br&gt;• clkout: rising-edge flop, CKO_LEAD = 2 cycles before E0, gated glitch-free by clk_en" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;strokeColor=#C62828;fillColor=#FFEBEE;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="480" y="300" width="300" height="150" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;clk_bit 480 MHz islands&lt;/b&gt; (flop → ≤ 1 gate → flop)&lt;br&gt;• &lt;b&gt;usb_tx_piso&lt;/b&gt; – 8:1 PISO per AFE pin, load on ld, idle clamp cq — &lt;b&gt;68 FF&lt;/b&gt;&lt;br&gt;• &lt;b&gt;usb_rx_fsls_sampler&lt;/b&gt; (usb_rx_datapath) – FS/LS 2-FF + 1:8 SIPO, 40× / 320× oversampling; tx_en capture — &lt;b&gt;56 FF&lt;/b&gt;&lt;br&gt;• &lt;b&gt;usb_pll_lock_det&lt;/b&gt; – 8-sample window-end word — &lt;b&gt;17 FF&lt;/b&gt;&lt;br&gt;• &lt;b&gt;usb_rx_status_sync&lt;/b&gt; – squelch / disconnect capture — &lt;b&gt;7 FF&lt;/b&gt;&lt;br&gt;• &lt;b&gt;usb_line_state&lt;/b&gt; input capture &lt;b&gt;2 FF&lt;/b&gt; · &lt;b&gt;usb_pwr_seq&lt;/b&gt; clk_en_b &lt;b&gt;2 FF&lt;/b&gt; · &lt;b&gt;usb_ulpi_phy_pads&lt;/b&gt; bit_rst_n sync &lt;b&gt;2 FF&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;strokeColor=#C62828;fillColor=#FFEBEE;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="820" y="290" width="670" height="170" as="geometry"/></mxCell><mxCell id="c30" value="clk_bit 480 MHz" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#C62828;strokeWidth=3;endArrow=block;endFill=1;fontColor=#C62828;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c17" target="c28"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="440" y="405"/><mxPoint x="440" y="375"/></Array></mxGeometry></mxCell><mxCell id="c31" value="clk_bit" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#C62828;strokeWidth=3;endArrow=block;endFill=1;fontColor=#C62828;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0.55;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c17" target="c29"><mxGeometry x="0.6" relative="1" as="geometry"><Array as="points"><mxPoint x="450" y="432"/><mxPoint x="450" y="270"/><mxPoint x="1188" y="270"/></Array></mxGeometry></mxCell><mxCell id="c32" value="ld / phase_j (E4 strobe)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#C62828;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#C62828;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;dashed=1;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="1" source="c28" target="c29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c33" value="&lt;b&gt;clk60 60 MHz core&lt;/b&gt; (≈ 1 300 FF, single-cycle 16.67 ns)&lt;br&gt;• &lt;b&gt;usb_ulpi_phy_top&lt;/b&gt; – usb_ulpi_core (input capture, TXCMD, usb_tx_datapath, reg access, burst mux, bus owner), usb_ulpi_rx_path, usb_ulpi_reg_file, usb_afe_trim_regs, usb_mode_term_ctrl — &lt;b&gt;503 FF&lt;/b&gt;&lt;br&gt;• &lt;b&gt;usb_rx_datapath&lt;/b&gt; – usb_rx_fsls_dpll, usb_rx_decoder8, event FIFO, output stage, word-FIFO read — &lt;b&gt;278 FF&lt;/b&gt;&lt;br&gt;• &lt;b&gt;usb_afe_tx_if8&lt;/b&gt; – driver select, lead / lag window, pin vectors — &lt;b&gt;205 FF&lt;/b&gt;&lt;br&gt;• &lt;b&gt;usb_rx_status_sync&lt;/b&gt; filters, VBUS / ID — &lt;b&gt;86 FF&lt;/b&gt; · &lt;b&gt;usb_pll_lock_det&lt;/b&gt; count — &lt;b&gt;37 FF&lt;/b&gt;&lt;br&gt;• &lt;b&gt;usb_line_state&lt;/b&gt; &lt;b&gt;17 FF&lt;/b&gt; · &lt;b&gt;usb_pwr_seq&lt;/b&gt; core copies &lt;b&gt;8 FF&lt;/b&gt; · &lt;b&gt;usb_ulpi_phy_pads&lt;/b&gt; RESETB sync &lt;b&gt;2 FF&lt;/b&gt; · &lt;b&gt;usb_afe_rx_if&lt;/b&gt; rx_en_hs / cdr_en &lt;b&gt;1 FF&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;strokeColor=#1565C0;fillColor=#E3F2FD;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="820" y="520" width="670" height="230" as="geometry"/></mxCell><mxCell id="c34" value="clk60 60 MHz" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1565C0;strokeWidth=3;endArrow=block;endFill=1;fontColor=#1565C0;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;" edge="1" parent="1" source="c28" target="c33"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="630" y="612"/></Array></mxGeometry></mxCell><mxCell id="c35" value="boundary rule: data on ld (E4)&lt;br&gt;MC setup 4 / hold 3 both ways" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#C62828;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#C62828;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;dashed=1;startArrow=block;startFill=1;exitX=0.35;exitY=1;exitDx=0;exitDy=0;entryX=0.35;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c29" target="c33"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c36" value="&lt;b&gt;clk_rx 480 MHz ±1000 ppm island&lt;/b&gt;&lt;br&gt;• &lt;b&gt;usb_afe_rx_if&lt;/b&gt; – squelch 2-FF, CDR lock / delay line, data delay; reset sync rst_rx_n / rst_rx_m_n / rst_rx_m2_n — &lt;b&gt;54 FF&lt;/b&gt;&lt;br&gt;• &lt;b&gt;usb_rx_hs_sipo&lt;/b&gt; – usb_rx_hs_frontend, 1:8 SIPO data + valid, Johnson ÷8 → clk_rxw — &lt;b&gt;58 FF&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;strokeColor=#2E7D32;fillColor=#E8F5E9;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="480" y="830" width="310" height="160" as="geometry"/></mxCell><mxCell id="c37" value="&lt;b&gt;clk_rxw = clk_rx / 8 (60 MHz ±1000 ppm)&lt;/b&gt;&lt;br&gt;• usb_rx_hs_sipo write gate&lt;br&gt;• &lt;b&gt;usb_rx_elastic_buffer&lt;/b&gt; (ASYNC word FIFO, 8 × 17 bit) write side, Gray write pointer — &lt;b&gt;148 FF&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;strokeColor=#00838F;fillColor=#E0F7FA;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="830" y="830" width="300" height="160" as="geometry"/></mxCell><mxCell id="c38" value="clk_rx 480 MHz ±1000 ppm" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2E7D32;strokeWidth=3;endArrow=block;endFill=1;fontColor=#2E7D32;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="c18" target="c36"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="430" y="695"/><mxPoint x="430" y="878"/></Array></mxGeometry></mxCell><mxCell id="c39" value="clk_rxw" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#00838F;strokeWidth=3;endArrow=block;endFill=1;fontColor=#00838F;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c36" target="c37"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c40" value="async: Gray pointers + 2-FF&lt;br&gt;set_max_delay 1 clk_rxw period" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#00838F;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#00838F;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.2;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c37" target="c33"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c41" value="cdr_en (clk60)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#757575;strokeWidth=1;endArrow=block;endFill=1;fontColor=#757575;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0;exitY=0.85;exitDx=0;exitDy=0;entryX=1;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="c33" target="c18"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="800" y="715"/><mxPoint x="800" y="790"/><mxPoint x="420" y="790"/><mxPoint x="420" y="728"/></Array></mxGeometry></mxCell><mxCell id="c42" value="&lt;b&gt;Crossings / SDC&lt;/b&gt;&lt;br&gt;• clk60 ↔ clk_bit: synchronous, cross only on ld (E4), never E0; multicycle 4 / 3 (exception: PISO clamp cq, single cycle)&lt;br&gt;• clk_rx → clk_rxw: synchronous ÷8, same E4 rule, MC 4 / 3&lt;br&gt;• clk_rx / clk_rxw ↔ clk60: asynchronous, word FIFO, max-delay&lt;br&gt;• clk_rx ↔ clk_bit / clkout: no paths (false path)&lt;br&gt;• ref_clk ↔ all: asynchronous clock group, 2-FF syncs&lt;br&gt;• ulpi_clk: virtual clock at the CLK pin, delta = CKO_FF + PAD_OUT − CKO_LEAD·T_bit ≈ −0.37 ns" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;strokeColor=#424242;fillColor=#FAFAFA;spacing=6;" vertex="1" parent="1"><mxGeometry x="1150" y="830" width="350" height="230" as="geometry"/></mxCell><mxCell id="c43" value="&lt;b&gt;BBSUD8F pad u_pad_clk&lt;/b&gt;&lt;br&gt;(usb_ulpi_phy_pads)&lt;br&gt;→ PAD_ULPI_CLK" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;strokeColor=#6A1B9A;fillColor=#F3E5F5;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1560" y="140" width="200" height="80" as="geometry"/></mxCell><mxCell id="c44" value="&lt;b&gt;USB Link (ULPI 1.1)&lt;/b&gt;&lt;br&gt;output-clock mode&lt;br&gt;CLK = &lt;b&gt;60 MHz&lt;/b&gt;&lt;br&gt;setup 6.0 / hold 0 / Tco 9.0 ns" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;strokeColor=#6A1B9A;fillColor=#FAFAFA;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1560" y="300" width="200" height="110" as="geometry"/></mxCell><mxCell id="c45" value="clkout 60 MHz (gated, stops low)" style="edgeStyle=orthogonalEdgeStyle;r