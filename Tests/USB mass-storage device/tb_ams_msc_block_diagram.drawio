8" target="c40"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1365" y="160"/><mxPoint x="1365" y="330"/></Array></mxGeometry></mxCell><mxCell id="c42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#d79b00;endArrow=none;startArrow=none;" edge="1" parent="1" source="c29" target="c40"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c43" value="&lt;b&gt;usb_fs_msc&lt;/b&gt;  u_msc&lt;br&gt;(Tests/USB mass-storage device/usb_fs_msc.va, Verilog-A)&lt;br&gt;&lt;br&gt;FS 12 Mbit/s, 1.5 k&amp;Omega; D+ pull-up after 20 &amp;micro;s&lt;br&gt;EP0 control (64 B)&lt;br&gt;EP1 OUT bulk: CBW&lt;br&gt;EP2 IN bulk: data + CSW&lt;br&gt;SCSI: TUR, INQUIRY,&lt;br&gt;READ CAPACITY(10), READ(10)&lt;br&gt;&lt;br&gt;&lt;i&gt;shadow: fs_msc_bm.v&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;verticalAlign=top;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1390" y="600" width="170" height="250" as="geometry"/></mxCell><mxCell id="c44" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#d79b00;endArrow=none;startArrow=none;" edge="1" parent="1" source="c40" target="c43"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c45" value="$cds_get_analog_value(&amp;quot;tb_ams_msc.dp/dm&amp;quot;)  (`AMS_VDP / `AMS_VDM): check_line" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;endFill=1;dashed=1;strokeColor=#82b366;" edge="1" parent="1" source="c40" target="c13"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1420" y="45"/><mxPoint x="200" y="45"/></Array></mxGeometry></mxCell><mxCell id="c46" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;blue: digital RTL / TB logic (Verilog-2005)&lt;br&gt;green: testbench host (Link model, sequence)&lt;br&gt;orange: Verilog-A models (Spectre)&lt;br&gt;grey dashed: AMS connect modules (inserted by xrun)&lt;br&gt;thick orange: electrical DP / DM line" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fillColor=#ffffff;strokeColor=#999999;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="50" y="760" width="300" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="seq" name="Test sequence"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="960" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c47" value="Test sequence (ams_msc_seq.vh) - every packet: Link &amp;rarr; ULPI &amp;rarr; PHY TX &amp;rarr; AFE &amp;rarr; DP/DM &amp;rarr; device and back" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=8;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="820" height="892" as="geometry"/></mxCell><mxCell id="c48" value="&lt;b&gt;1. Power-up&lt;/b&gt; &amp;mdash; por_n, resetb; wait 200 ULPI clocks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="780" height="40" as="geometry"/></mxCell><mxCell id="c49" value="&lt;b&gt;2. PHY identification&lt;/b&gt; &amp;mdash; reg 00h-03h = 24h 04h 07h 00h, scratch 16h = A5h" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="112" width="780" height="40" as="geometry"/></mxCell><mxCell id="c50" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="c48" target="c49"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c51" value="&lt;b&gt;3. Host mode&lt;/b&gt; &amp;mdash; OTG Ctrl 66h (pull-downs, DrvVbus); FuncCtrl 45h (FS host)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="164" width="780" height="40" as="geometry"/></mxCell><mxCell id="c52" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="c49" target="c51"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c53" value="&lt;b&gt;4. Attach&lt;/b&gt; &amp;mdash; Debug[1:0] 00 &amp;rarr; 01 (J); debounce 10 &amp;micro;s; DP &amp;gt; 2.7 V, DM &amp;lt; 0.3 V" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="216" width="780" height="40" as="geometry"/></mxCell><mxCell id="c54" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="c51" target="c53"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c55" value="&lt;b&gt;5. Bus reset&lt;/b&gt; &amp;mdash; FuncCtrl 50h: 45 &amp;Omega; terms &amp;rarr; SE0 10 &amp;micro;s (line checked); FuncCtrl 45h; J again" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="268" width="780" height="40" as="geometry"/></mxCell><mxCell id="c56" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="c53" target="c55"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c57" value="&lt;b&gt;6. GET_DESCRIPTOR(device, 8) @0&lt;/b&gt; &amp;mdash; SOF, SETUP/DATA0/ACK, IN/DATA1/ACK, OUT/ZLP/ACK; bMaxPacketSize0 = 64" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="780" height="40" as="geometry"/></mxCell><mxCell id="c58" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="c55" target="c57"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c59" value="&lt;b&gt;7. SET_ADDRESS(7)&lt;/b&gt; &amp;mdash; SETUP + IN status ZLP; 10 &amp;micro;s recovery" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="372" width="780" height="40" as="geometry"/></mxCell><mxCell id="c60" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="c57" target="c59"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c61" value="&lt;b&gt;8. GET_DESCRIPTOR(device, 18)&lt;/b&gt; &amp;mdash; bcdUSB 1.10, VID 1234h, PID 5680h, 1 configuration" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="424" width="780" height="40" as="geometry"/></mxCell><mxCell id="c62" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="c59" target="c61"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c63" value="&lt;b&gt;9. GET_DESCRIPTOR(config, 9 / 32)&lt;/b&gt; &amp;mdash; class 08h / subclass 06h / protocol 50h; EP1 OUT + EP82 IN bulk, 64 B" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="476" width="780" height="40" as="geometry"/></mxCell><mxCell id="c64" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="c61" target="c63"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c65" value="&lt;b&gt;10. SET_CONFIGURATION(1)&lt;/b&gt; &amp;mdash; bulk toggles reset" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="528" width="780" height="40" as="geometry"/></mxCell><mxCell id="c66" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="c63" target="c65"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c67" value="&lt;b&gt;11. GET_MAX_LUN&lt;/b&gt; &amp;mdash; class request A1h/FEh &amp;rarr; 0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="580" width="780" height="40" as="geometry"/></mxCell><mxCell id="c68" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="c65" target="c67"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c69" value="&lt;b&gt;12. TEST UNIT READY&lt;/b&gt; &amp;mdash; CBW (31 B, EP1 OUT) &amp;rarr; CSW (13 B, EP2 IN): &#x27;USBS&#x27;, tag, residue 0, status 0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="632" width="780" height="40" as="geometry"/></mxCell><mxCell id="c70" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="c67" target="c69"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c71" value="&lt;b&gt;13. INQUIRY (36 B)&lt;/b&gt; &amp;mdash; CBW &amp;rarr; 36 B data &amp;rarr; CSW; &#x27;ACME&#x27;, &#x27;VA FS Disk&#x27;, &#x27;1.00&#x27;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="684" width="780" height="40" as="geometry"/></mxCell><mxCell id="c72" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="c69" target="c71"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c73" value="&lt;b&gt;14. READ CAPACITY(10)&lt;/b&gt; &amp;mdash; CBW &amp;rarr; 8 B: last LBA FFFFh, block 512 &amp;rarr; CSW" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="736" width="780" height="40" as="geometry"/></mxCell><mxCell id="c74" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="c71" target="c73"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c75" value="&lt;b&gt;15. READ(10) LBA 0, 1 block&lt;/b&gt; &amp;mdash; CBW &amp;rarr; 8 &amp;times; 64 B DATA0/1 (CRC16, toggles) &amp;rarr; CSW; pattern + 55 AAh" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="788" width="780" height="40" as="geometry"/></mxCell><mxCell id="c76" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="c73" target="c75"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c77" value="&lt;b&gt;16. Verdict&lt;/b&gt; &amp;mdash; errors + Link BFM errors = 0 &amp;rarr; TEST PASSED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="840" width="780" height="40" as="geometry"/></mxCell><mxCell id="c78" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="c75" target="c77"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c79" value="&lt;b&gt;Phases&lt;/b&gt;&lt;br&gt;green: PHY / port set-up&lt;br&gt;blue: USB enumeration (EP0 control transfers)&lt;br&gt;orange: Mass Storage Bulk-Only Transport (EP1 OUT, EP2 IN)&lt;br&gt;&lt;br&gt;Scaled times: debounce, reset, recovery,&lt;br&gt;SET_ADDRESS recovery = 10 &amp;micro;s each.&lt;br&gt;Simulated time &amp;asymp; 1.5 ms." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fillColor=#ffffff;strokeColor=#999999;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="860" y="60" width="300" height="200" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
