<mxfile host="app.diagrams.net" type="device"><diagram id="blk" name="Block diagram"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="940" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c11" value="tb_ams_msc  (AFE/ams/tb_ams_msc.vams, Verilog-AMS top)   |   Icarus shadow: tb_ams_msc_shadow.v" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=8;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1560" height="900" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;TB stimulus (digital)&lt;/b&gt;&lt;br&gt;clk_bit 480 MHz (HALF = 1.0417 ns)&lt;br&gt;por_n, resetb (regs)&lt;br&gt;watchdog 20 ms" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=top;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="50" y="70" width="230" height="120" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Host sequence + checks&lt;/b&gt;&lt;br&gt;&lt;i&gt;AFE/ams/ams_msc_seq.vh&lt;/i&gt;&lt;br&gt;(`include&#x27;d inside the top)&lt;br&gt;&lt;br&gt;1. PHY IDs 0424h/0007h, scratch&lt;br&gt;2. host mode: OTG 66h, FuncCtrl 45h&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;attach: LineState J (FS)&lt;br&gt;3. bus reset: FuncCtrl 50h (45 &amp;Omega;) &amp;rarr; SE0&lt;br&gt;4. GET_DESCRIPTOR dev 8 @ addr 0&lt;br&gt;5. SET_ADDRESS(7)&lt;br&gt;6. GET_DESCRIPTOR dev 18, cfg 9/32&lt;br&gt;7. SET_CONFIGURATION(1), GET_MAX_LUN&lt;br&gt;8. BOT: TEST UNIT READY, INQUIRY,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;READ CAPACITY(10), READ(10) 512 B&lt;br&gt;&amp;rarr; TEST PASSED / TEST FAILED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;verticalAlign=top;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="50" y="230" width="300" height="300" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;ULPI Link BFM&lt;/b&gt;  u_link&lt;br&gt;&lt;i&gt;ulpi_link_bfm&lt;/i&gt;&lt;br&gt;(Tests/USB ULPI Mouse/ulpi_tb_template.v)&lt;br&gt;&lt;br&gt;TX CMD / reg read-write / packet TX,&lt;br&gt;RX monitor (RXCMD, rx_buf),&lt;br&gt;TX CMD retry on PHY abort (dir)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;verticalAlign=top;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="50" y="570" width="300" height="150" as="geometry"/></mxCell><mxCell id="c15" value="tasks: link_tx_packet,&lt;br&gt;link_reg_read/write,&lt;br&gt;link_wait_rx_packet" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="&lt;b&gt;ams_ulpi_phy&lt;/b&gt;  u_phy   (AFE/ams/ams_ulpi_phy.v, 35 usb_*.v RTL files)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=top;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="420" y="70" width="560" height="780" as="geometry"/></mxCell><mxCell id="c17" value="usb_clk_gen&lt;br&gt;clk_bit &amp;divide;8 &amp;rarr; clk60 / ULPI CLK, ld" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1"><mxGeometry x="440" y="110" width="250" height="60" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;usb_ulpi_phy_top&lt;/b&gt;&lt;br&gt;usb_ulpi_phy_if &amp;rarr; usb_ulpi_core (input capture, TX CMD decode, reg access, bus owner)&lt;br&gt;+ usb_ulpi_rx_path (RX FIFO, RXCMD gen, out arbiter)&lt;br&gt;usb_ulpi_reg_file, usb_afe_trim_regs, usb_mode_term_ctrl&lt;br&gt;usb_tx_datapath: holding &amp;rarr; sync mux &amp;rarr; bit stuffer &amp;rarr; NRZI &amp;rarr; serializer8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontS