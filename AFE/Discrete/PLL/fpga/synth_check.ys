# synth_check.ys - Yosys smoke synthesis of the FPGA design for xc7 (no Vivado needed)
#   yosys -q -s synth_check.ys    (from AFE/Discrete/PLL/fpga)
read_verilog ../../../../usb_clk_gen.v ../../../../usb_pll_lock_det.v
read_verilog rtl/pll_ctrl.v rtl/pll_meas.v rtl/pll_fpga_top.v
synth_xilinx -family xc7 -top pll_fpga_top -flatten
check -assert
stat
