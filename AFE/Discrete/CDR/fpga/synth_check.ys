# synth_check.ys - Yosys smoke synthesis of the FPGA design for xc7 (no Vivado needed)
#   yosys -q -s synth_check.ys    (from AFE/Discrete/CDR/fpga)
read_verilog ../../../../usb_tx_path.v ../../../../usb_bit_stuffer.v ../../../../usb_nrzi_encoder.v
read_verilog ../../../../usb_tx_serializer8.v ../../../../usb_rx_decoder8.v
read_verilog rtl/cdr_ctrl.v rtl/cdr_txgen.v rtl/cdr_rxchk.v rtl/cdr_fpga_top.v
synth_xilinx -family xc7 -top cdr_fpga_top -flatten
check -assert
stat
