## aio_zedboard.xdc - aio_fpga_top on a Digilent ZedBoard Rev D.2 (XC7Z020CLG484-2)
## GENERATED by gen_xdc.py from ../easyeda/fmc_pinmap.csv - do not edit the pin section by hand.
## VADJ (J18) must be 2.5 V: LVDS_25 outputs and DIFF_TERM need VCCO = 2.5 V in banks 34 / 35.

# ---- ZedBoard ----
set_property -dict {PACKAGE_PIN Y9    IOSTANDARD LVCMOS33} [get_ports {gclk}]          ;# GCLK 100 MHz oscillator, bank 13
set_property -dict {PACKAGE_PIN P16   IOSTANDARD LVCMOS25} [get_ports {btn_rst}]       ;# BTNC, bank 34
set_property -dict {PACKAGE_PIN F22   IOSTANDARD LVCMOS25} [get_ports {sw[0]}]         ;# SW0, bank 35: UART block select
set_property -dict {PACKAGE_PIN G22   IOSTANDARD LVCMOS25} [get_ports {sw[1]}]         ;# SW1, bank 35: UART block select
set_property -dict {PACKAGE_PIN T22   IOSTANDARD LVCMOS33} [get_ports {led[0]}]        ;# LD0 MMCM locked
set_property -dict {PACKAGE_PIN T21   IOSTANDARD LVCMOS33} [get_ports {led[1]}]        ;# LD1 TX active
set_property -dict {PACKAGE_PIN U22   IOSTANDARD LVCMOS33} [get_ports {led[2]}]        ;# LD2 RX squelch / armed
set_property -dict {PACKAGE_PIN U21   IOSTANDARD LVCMOS33} [get_ports {led[3]}]        ;# LD3 PLL lock
set_property -dict {PACKAGE_PIN V22   IOSTANDARD LVCMOS33} [get_ports {led[4]}]        ;# LD4 CDR CLK_RX alive
set_property -dict {PACKAGE_PIN W22   IOSTANDARD LVCMOS33} [get_ports {led[5]}]        ;# LD5 CDR packets OK
set_property -dict {PACKAGE_PIN U19   IOSTANDARD LVCMOS33} [get_ports {led[6]}]        ;# LD6 UART select [0]
set_property -dict {PACKAGE_PIN U14   IOSTANDARD LVCMOS33} [get_ports {led[7]}]        ;# LD7 UART select [1]
set_property -dict {PACKAGE_PIN AA11  IOSTANDARD LVCMOS33} [get_ports {uart_txd}]      ;# JA2 -> PmodUSBUART RXD
set_property -dict {PACKAGE_PIN Y10   IOSTANDARD LVCMOS33} [get_ports {uart_rxd}]      ;# JA3 <- PmodUSBUART TXD

# ---- FMC LPC (VITA 57.1) ----
#   port            ZedBoard  FMC   LA signal      board net            block
set_property PACKAGE_PIN L18   [get_ports clk_rx_p        ] ;# H4   CLK0_M2C_P    CLK_RX_P_F           CDR  IO_L12P_T1_MRCC_34
set_property PACKAGE_PIN L19   [get_ports clk_rx_n        ] ;# H5   CLK0_M2C_N    CLK_RX_N_F           CDR  IO_L12N_T1_MRCC_34
set_property PACKAGE_PIN D18   [get_ports clk60_a_p       ] ;# G2   CLK1_M2C_P    CLK60_A_P_F          PLL  IO_L12P_T1_MRCC_35
set_property PACKAGE_PIN C19   [get_ports clk60_a_n       ] ;# G3   CLK1_M2C_N    CLK60_A_N_F          PLL  IO_L12N_T1_MRCC_35
set_property PACKAGE_PIN M19   [get_ports hs_rxd_p        ] ;# G6   LA00_P_CC     HS_RXD_P_F           CDR  IO_L13P_T2_MRCC_34
set_property PACKAGE_PIN M20   [get_ports hs_rxd_n        ] ;# G7   LA00_N_CC     HS_RXD_N_F           CDR  IO_L13N_T2_MRCC_34
set_property PACKAGE_PIN N19   [get_ports dpat_p          ] ;# D8   LA01_P_CC     DPAT_P_F             CDR  IO_L14P_T2_SRCC_34
set_property PACKAGE_PIN N20   [get_ports dpat_n          ] ;# D9   LA01_N_CC     DPAT_N_F             CDR  IO_L14N_T2_SRCC_34
set_property PACKAGE_PIN P17   [get_ports tx_in_p_p       ] ;# H7   LA02_P        TX_IN_P_P            TX
set_property PACKAGE_PIN P18   [get_ports tx_in_p_n       ] ;# H8   LA02_N        TX_IN_P_N            TX
set_property PACKAGE_PIN N22   [get_ports tx_in_n_p       ] ;# G9   LA03_P        TX_IN_N_P            TX
set_property PACKAGE_PIN P22   [get_ports tx_in_n_n       ] ;# G10  LA03_N        TX_IN_N_N            TX
set_property PACKAGE_PIN M21   [get_ports rx_out_p        ] ;# H10  LA04_P        RX_OUT_P_F           RX
set_property PACKAGE_PIN M22   [get_ports rx_out_n        ] ;# H11  LA04_N        RX_OUT_N_F           RX
set_property PACKAGE_PIN B19   [get_ports clk_bit_a_p     ] ;# D20  LA17_P_CC     CLK_BIT_A_P_F        PLL  IO_L13P_T2_MRCC_35
set_property PACKAGE_PIN B20   [get_ports clk_bit_a_n     ] ;# D21  LA17_N_CC     CLK_BIT_A_N_F        PLL  IO_L13N_T2_MRCC_35
set_property PACKAGE_PIN J18   [get_ports tx_en           ] ;# D11  LA05_P        TX_EN_F              TX
set_property PACKAGE_PIN K18   [get_ports fs_oe           ] ;# D12  LA05_N        FS_OE_F              TX
set_property PACKAGE_PIN L21   [get_ports fs_dat          ] ;# C10  LA06_P        FS_DAT_F             TX
set_property PACKAGE_PIN L22   [get_ports fs_se0          ] ;# C11  LA06_N        FS_SE0_F             TX
set_property PACKAGE_PIN T16   [get_ports fs_ls           ] ;# H13  LA07_P        FS_LS_F              TX
set_property PACKAGE_PIN T17   [get_ports fs_suspnd       ] ;# H14  LA07_N        FS_SUSPND_F          TX
set_property PACKAGE_PIN J21   [get_ports dp_pullup_en    ] ;# G12  LA08_P        DP_PULLUP_EN_F       TX
set_property PACKAGE_PIN J22   [get_ports hs_term_en      ] ;# G13  LA08_N        HS_TERM_EN_F         TX
set_property PACKAGE_PIN R20   [get_ports pd_en0          ] ;# D14  LA09_P        PD_EN0_F             TX
set_property PACKAGE_PIN R21   [get_ports pd_en1          ] ;# D15  LA09_N        PD_EN1_F             TX
set_property PACKAGE_PIN R19   [get_ports rxrcv           ] ;# C14  LA10_P        RXRCV_F              TX
set_property PACKAGE_PIN T19   [get_ports rxdp            ] ;# C15  LA10_N        RXDP_F               TX
set_property PACKAGE_PIN N17   [get_ports rxdm            ] ;# H16  LA11_P        RXDM_F               TX
set_property PACKAGE_PIN N18   [get_ports vbus_det        ] ;# H17  LA11_N        VBUS_DET_F           TX
set_property PACKAGE_PIN P20   [get_ports tx_dac_cs_n     ] ;# G15  LA12_P        TX_DAC_CS_N_F        TX
set_property PACKAGE_PIN P21   [get_ports spi_sck         ] ;# G16  LA12_N        SPI_SCK_F            TX
set_property PACKAGE_PIN L17   [get_ports spi_sdi         ] ;# D17  LA13_P        SPI_SDI_F            TX
set_property PACKAGE_PIN M17   [get_ports rx_dac_cs_n     ] ;# D18  LA13_N        RX_DAC_CS_N_F        RX
set_property PACKAGE_PIN K19   [get_ports squelch_a       ] ;# C18  LA14_P        SQUELCH_A_F          RX  IO_L11P_T1_SRCC_34
set_property PACKAGE_PIN K20   [get_ports disc_a          ] ;# C19  LA14_N        DISC_A_F             RX  IO_L11N_T1_SRCC_34
set_property PACKAGE_PIN J16   [get_ports rx_en           ] ;# H19  LA15_P        RX_EN_F              RX
set_property PACKAGE_PIN D20   [get_ports ref_dig         ] ;# C22  LA18_P_CC     REF_DIG_F            PLL  IO_L14P_T2_SRCC_35
set_property PACKAGE_PIN C20   [get_ports muxout          ] ;# C23  LA18_N_CC     MUXOUT_F             PLL  IO_L14N_T2_SRCC_35
set_property PACKAGE_PIN J20   [get_ports adf_clk         ] ;# G18  LA16_P        ADF_CLK_F            PLL
set_property PACKAGE_PIN K21   [get_ports adf_data        ] ;# G19  LA16_N        ADF_DATA_F           PLL
set_property PACKAGE_PIN G15   [get_ports adf_le          ] ;# H22  LA19_P        ADF_LE_F             PLL
set_property PACKAGE_PIN G16   [get_ports adf_ce          ] ;# H23  LA19_N        ADF_CE               PLL
set_property PACKAGE_PIN G20   [get_ports pll_vco_off     ] ;# G21  LA20_P        PLL_VCO_OFF_F        PLL
set_property PACKAGE_PIN G21   [get_ports lf_dis          ] ;# G22  LA20_N        LF_DIS_F             PLL
set_property PACKAGE_PIN E19   [get_ports ol_en           ] ;# H25  LA21_P        OL_EN_F              PLL
set_property PACKAGE_PIN E20   [get_ports cdcm_off        ] ;# H26  LA21_N        CDCM_OFF_F           PLL
set_property PACKAGE_PIN G19   [get_ports pll_dac_cs_n    ] ;# G24  LA22_P        PLL_DAC_CS_N_F       PLL
set_property PACKAGE_PIN F19   [get_ports pll_adc_cs_n    ] ;# G25  LA22_N        PLL_ADC_CS_N_F       PLL
set_property PACKAGE_PIN E15   [get_ports pll_adc_sdo     ] ;# D23  LA23_P        PLL_ADC_SDO_F        PLL
set_property PACKAGE_PIN D15   [get_ports refsrc0         ] ;# D24  LA23_N        REFSRC0_F            PLL
set_property PACKAGE_PIN A18   [get_ports refsrc1         ] ;# H28  LA24_P        REFSRC1_F            PLL
set_property PACKAGE_PIN A19   [get_ports oe24            ] ;# H29  LA24_N        OE24_F               PLL
set_property PACKAGE_PIN D22   [get_ports oe19            ] ;# G27  LA25_P        OE19_F               PLL
set_property PACKAGE_PIN F18   [get_ports cdr_en          ] ;# D26  LA26_P        CDR_EN_F             CDR
set_property PACKAGE_PIN E18   [get_ports cdr_set         ] ;# D27  LA26_N        CDR_SET_F            CDR
set_property PACKAGE_PIN E21   [get_ports dsel0           ] ;# C26  LA27_P        DSEL0_F              CDR
set_property PACKAGE_PIN D21   [get_ports dsel1           ] ;# C27  LA27_N        DSEL1_F              CDR
set_property PACKAGE_PIN A16   [get_ports cdr_vco_off     ] ;# H31  LA28_P        CDR_VCO_OFF_F        CDR
set_property PACKAGE_PIN A17   [get_ports csw_ext         ] ;# H32  LA28_N        CSW_EXT_F            CDR
set_property PACKAGE_PIN C17   [get_ports csw_dac         ] ;# G30  LA29_P        CSW_DAC_F            CDR  IO_L11P_T1_SRCC_35
set_property PACKAGE_PIN C18   [get_ports cdr_dac_cs_n    ] ;# G31  LA29_N        CDR_DAC_CS_N_F       CDR  IO_L11N_T1_SRCC_35
set_property PACKAGE_PIN C15   [get_ports cdr_adc_cs_n    ] ;# H34  LA30_P        CDR_ADC_CS_N_F       CDR
set_property PACKAGE_PIN B15   [get_ports cdr_adc_sdo     ] ;# H35  LA30_N        CDR_ADC_SDO_F        CDR

set_property IOSTANDARD LVDS_25  [get_ports {clk60_a_n clk60_a_p clk_bit_a_n clk_bit_a_p clk_rx_n clk_rx_p dpat_n dpat_p hs_rxd_n hs_rxd_p rx_out_n rx_out_p tx_in_n_n tx_in_n_p tx_in_p_n tx_in_p_p}]
set_property DIFF_TERM  TRUE     [get_ports {clk60_a_n clk60_a_p clk_bit_a_n clk_bit_a_p clk_rx_n clk_rx_p hs_rxd_n hs_rxd_p}]
set_property IOSTANDARD LVCMOS25 [get_ports {adf_ce adf_clk adf_data adf_le cdcm_off cdr_adc_cs_n cdr_adc_sdo cdr_dac_cs_n cdr_en cdr_set cdr_vco_off csw_dac csw_ext disc_a dp_pullup_en dsel0 dsel1 fs_dat fs_ls fs_oe fs_se0 fs_suspnd hs_term_en lf_dis muxout oe19 oe24 ol_en pd_en0 pd_en1 pll_adc_cs_n pll_adc_sdo pll_dac_cs_n pll_vco_off ref_dig refsrc0 refsrc1 rx_dac_cs_n rx_en rxdm rxdp rxrcv spi_sck spi_sdi squelch_a tx_dac_cs_n tx_en vbus_det}]
set_property SLEW FAST [get_ports {tx_en fs_oe fs_dat fs_se0 fs_ls}]
set_property DRIVE 8   [get_ports {tx_en fs_oe fs_dat fs_se0 fs_ls}]

# ---- clocks ----
create_clock -period 10.000 -name gclk      [get_ports gclk]          ;# 100 MHz; MMCM outputs derived
create_clock -period  2.083 -name clk_rx    [get_ports clk_rx_p]      ;# CDR recovered clock, 480 MHz
create_clock -period  2.083 -name clk_bit_a [get_ports clk_bit_a_p]   ;# PLL board, 480 MHz
create_clock -period 16.667 -name clk60_a   [get_ports clk60_a_p]     ;# PLL board /8
create_clock -period 41.667 -name ref_dig   [get_ports ref_dig]       ;# 24 MHz (19.2 / 26 also fit)
# usb_clk_gen's clk60 (BUFG) is a generated clock of CLK_BIT_A (/8)
create_generated_clock -name clk60_gen -source [get_ports clk_bit_a_p] -divide_by 8 \
    [get_pins -hierarchical -filter {NAME =~ *u_pll/u_cg*clk60_reg/Q}]

# The MMCM must share the clock region of bank 34 (its 480 MHz output drives
# the RX sampler's BUFIO / BUFR).  Vivado places it there by itself; to pin it:
# set_property LOC MMCME2_ADV_X1Y0 [get_cells u_mmcm/mmcm_adv_inst]   ;# check the region in the device view

# ---- clock domain crossings ----
# PLL block: the 60 <-> 480 boundary of usb_clk_gen transfers on ld (E4), as in
# constraints/usb_phy.sdc of the PHY (multicycle 4 / 3).
set_multicycle_path -setup 4 -from [get_clocks clk60_gen] -to [get_clocks clk_bit_a]
set_multicycle_path -hold  3 -from [get_clocks clk60_gen] -to [get_clocks clk_bit_a]
set_multicycle_path -setup 4 -from [get_clocks clk_bit_a] -to [get_clocks clk60_gen] -end
set_multicycle_path -hold  3 -from [get_clocks clk_bit_a] -to [get_clocks clk60_gen] -end
# Everything else between the groups goes through 2-FF synchronisers, toggle
# handshakes, Gray-coded counters or the RX capture BRAM (read after `done`).
#   sys:  MMCM 240 / 200 / 60 MHz (TX OSERDESE2 CLK / CLKDIV are synchronous)
#   rx:   MMCM 480 MHz (BUFIO) and BUFR /4 of the RX sampler
set_clock_groups -asynchronous \
    -group [get_clocks -of_objects [get_pins {u_mmcm/CLKOUT1 u_mmcm/CLKOUT2 u_mmcm/CLKOUT3}]] \
    -group [get_clocks -of_objects [get_pins {u_mmcm/CLKOUT0 u_bufr_rx/O}]] \
    -group [get_clocks -include_generated_clocks clk_rx] \
    -group [get_clocks -include_generated_clocks clk_bit_a] \
    -group [get_clocks clk60_a] \
    -group [get_clocks ref_dig]
# PLL: CLK60_A as data into the clk_bit sampler (phase check), asynchronous by design.
set_false_path -to [get_pins -hierarchical -filter {NAME =~ *u_pll/u_meas*bs_reg[0]/D}]

# ---- I/O ----
# CDR: HS_RXD is launched by the board on the CLK_RX rising edge (EP29 tpd
# 0.42 ns + NB6L14 output skew); the capture is tuned with IDLY (eye scan), so
# the input delay is a sanity bound, not a sign-off.
# Window 0.25 .. 0.65 ns = EP29 tpd 0.42 ns typ +- 0.15 ns, NB6L14 Q1/Q2 skew
# <= 20 ps, matched traces (cdr_board.md); the 0.2 .. 0.9 ns guess left no
# tap meeting both checks.  The BUFIO clock reaches the ISERDESE2 ~2.8 ns after
# the pin, the data at IDELAY tap 0 ~1.45 ns: tap 0 fails hold by ~1.3 ns,
# tap 22 failed setup by 0.35 ns (old window).  Vivado times the IDELAY at
# IDELAY_VALUE = IDLY0 = 19 (reset value of IDLY); the eye scan trims it.
set_input_delay -clock clk_rx -max 0.65 [get_ports {hs_rxd_p}]
set_input_delay -clock clk_rx -min 0.25 [get_ports {hs_rxd_p}]
# RX_OUT, SQUELCH_A, DISC_A are oversampled by ISERDESE2s; the OSERDESE2
# outputs (TX_IN, TX_EN, FS_*, DPAT) have a fixed CLK-to-OQ; the rest is static,
# slow (SPI, ADF4002 bus) or asynchronous.
set_false_path -from [get_ports {rx_out_p rx_out_n squelch_a disc_a vbus_det rxrcv rxdp rxdm \
    muxout pll_adc_sdo cdr_adc_sdo uart_rxd btn_rst sw[*]}]
set_false_path -to [get_ports {dp_pullup_en hs_term_en pd_en0 pd_en1 fs_suspnd rx_en \
    tx_dac_cs_n rx_dac_cs_n pll_dac_cs_n pll_adc_cs_n cdr_dac_cs_n cdr_adc_cs_n spi_sck spi_sdi \
    adf_* pll_vco_off lf_dis ol_en cdcm_off refsrc* oe24 oe19 \
    cdr_en cdr_set dsel* cdr_vco_off csw_* uart_txd led[*]}]

